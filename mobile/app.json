{
  "expo": {
    "name": "FitOS",
    "slug": "fitos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.rbsconsulting.fitos",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.rbsconsulting.fitos",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#007AFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O FitOS acessa suas fotos para reconhecer os alimentos do prato.",
          "cameraPermission": "O FitOS usa a câmera para fotografar o prato e estimar as calorias."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O FitOS usa a câmera para ler o código de barras dos produtos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#007AFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8da6f878-4b2b-47e4-b51c-320adb4f0101"
      }
    },
    "owner": "rbs-consulting"
  }
}
