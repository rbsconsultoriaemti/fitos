NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://fitos:fitos@localhost:5432/fitos
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=troque-isto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
APP_TIMEZONE=America/Sao_Paulo
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=troque-isto
# Claude API (plano gerado no onboarding). Nunca commitar a chave.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5
# RevenueCat (webhook de assinaturas). O mesmo valor é colado no painel do RevenueCat, no campo Authorization.
REVENUECAT_WEBHOOK_AUTH=troque-isto
# Só para testes: aceitar eventos de sandbox como se fossem compras reais. Nunca true em produção.
REVENUECAT_ACCEPT_SANDBOX=false
